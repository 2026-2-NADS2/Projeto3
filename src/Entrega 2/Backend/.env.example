NODE_ENV=development
PORT=3333
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:4174
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=collision_api
DB_USER=collision
DB_PASSWORD=defina_localmente
# Gere um segredo aleatorio com pelo menos 32 caracteres. Nunca use VITE_JWT_SECRET.
JWT_SECRET=substitua_por_um_segredo_aleatorio_de_32_caracteres_ou_mais
JWT_TTL_SECONDS=1800
FRONTEND_URL=http://localhost:5173
# Valores usados somente pelos comandos db:admin e db:demo.
ADMIN_NOME=Administrador Collision
ADMIN_EMAIL=admin@example.com
ADMIN_SENHA=
DEMO_PASSWORD=
# Recuperacao: sem SMTP, desenvolvimento grava mensagem em .local/emails.
# Em producao SMTP precisa ser configurado para habilitar recuperacao.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
